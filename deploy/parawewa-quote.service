[Unit]
Description=Parawewa quote form (emails website quote requests)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parawewa
Group=parawewa
WorkingDirectory=/var/www/parawawa/current
EnvironmentFile=/etc/parawewa/quote.env
ExecStart=/usr/bin/node /var/www/parawawa/current/deploy/quote-server.js
Restart=always
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
