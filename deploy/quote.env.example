# Copy to /etc/parawewa/quote.env on the server (chmod 600, owned by root) and fill in.
# Never commit the real file.

PORT=3005

# Resend API key (https://resend.com -> API Keys)
RESEND_API_KEY=

# Who receives every quote request (comma-separated)
QUOTE_TO=info@parawawa.lk, you@example.com

# Sender. Leave empty until parawewa.lk is verified in Resend;
# then e.g.: QUOTE_FROM=Parawewa Website <quotes@parawewa.lk>
QUOTE_FROM=
