{
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/about",
      "destination": "/#founder",
      "permanent": true
    },
    {
      "source": "/en/about/",
      "destination": "/#founder",
      "permanent": true
    },
    {
      "source": "/en/services",
      "destination": "/#models",
      "permanent": true
    },
    {
      "source": "/en/services/",
      "destination": "/#models",
      "permanent": true
    },
    {
      "source": "/en/projects",
      "destination": "/#customers",
      "permanent": true
    },
    {
      "source": "/en/projects/",
      "destination": "/#customers",
      "permanent": true
    },
    {
      "source": "/en/contact-us",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/en/contact-us/",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/en/articles.html",
      "destination": "/articles.html",
      "permanent": true
    },
    {
      "source": "/en/sample-page/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/hello-world/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/category/uncategorized/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/si",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/si/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/articles",
      "destination": "/articles.html",
      "permanent": true
    },
    {
      "source": "/articles/",
      "destination": "/articles.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/fa/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(style\\.css|app\\.js|articles-meta\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(fa/fa-subset|fonts/fonts)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(tools|content)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
